  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/eslint__js": "^8.42.3",
    "@types/stats.js": "^0.17.4",
    "esbuild": "^0.25.5",
    "eslint": "^9.30.0",
    "stats.js": "^0.17.0",
    "typescript-eslint": "^8.35.0"
  }
}
