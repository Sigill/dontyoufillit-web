{
  "name": "dontyoufillit-web",
  "version": "1.0.0",
  "description": "DontYouFillIt is a Breakout-style game mixed with snooker.",
  "private": true,
  "scripts": {
    "build-js": "npx esbuild --bundle --outfile=www/app.js --sourcemap app.ts",
    "build-css": "npx esbuild --minify --outfile=www/app.css --sourcemap app.css",
    "build-watch": "npm run build-js -- --watch",
    "build": "make"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sigill/dontyoufillit-web.git"
  },
